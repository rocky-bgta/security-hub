# Copy to .env on the VPS (never commit real .env).
# docker compose reads these automatically.

ECR_REGISTRY=123456789012.dkr.ecr.us-east-1.amazonaws.com
TAG=v1.0.0-dev
ENVIRONMENT=dev

# Standalone MongoDB (required for all Mongo-backed services)
# Example: mongodb://admin:CHANGE_ME@15.204.246.10:28395/?authSource=admin
MONGODB_URI=mongodb://admin:CHANGE_ME@HOST:28395/?authSource=admin

# Optional overrides
# REDIS_HOST=asat-redis
