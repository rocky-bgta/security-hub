  "notes": {
    "paymentStatus": {
      "PENDING": "Use for online payments (Stripe/PayPal). Invoice created with PENDING status. MSP will be activated after successful payment via webhook.",
      "COMPLETED": "Use for manual payments (BANK_TRANSFER/CHECK_PAYMENT). Invoice created with PAID status. MSP will be activated immediately."
    },
    "calculationOrder": {
      "step1": "Apply coupon discount (if couponCode is provided)",
      "step2": "Apply invoice discount (if discountType and discountAmount/discountPercentage are provided)",
      "step3": "Calculate VAT on the discounted subtotal using vatRate"
    },
    "requiredFields": {
      "organization": "All fields except logoUrl, tierId, mspTypeId, and streetAddressLine2 are required",
      "billing": "billingEmail and billingName are required. Address fields are optional but recommended",
      "productSelections": "All fields are required except userRangeId (can be null)",
      "invoice": "subtotal, vatRate, totalAmount, and paymentStatus are required",
      "completedPayment": "Required when paymentStatus is COMPLETED. Must include paymentMethod and corresponding payment details (bankTransferDetails or checkPaymentDetails)"
    },
    "creditInfo": {
      "note": "Optional field. If enableCredit is true, creditAmount, reason, and creditStartDate are required",
      "autoSuspendOnOverdue": "Optional boolean to auto-suspend account when payment is overdue",
      "netDaysId": "Optional net payment days ID for invoice settlement terms"
    },
    "activationFlow": {
      "onlinePayment": "1. Create invoice with PENDING status -> 2. User pays via Stripe/PayPal -> 3. Webhook updates payment -> 4. System activates MSP automatically",
      "manualPayment": "1. Create invoice with PAID status -> 2. System activates MSP immediately"
    }
  }
}

