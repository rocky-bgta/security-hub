  "paymentMethodSummary": {
    "PENDING": {
      "description": "No payment method selected. Invoice created as PENDING status.",
      "completedPayment": "Must be null",
      "nextSteps": "Client admin will see invoice in pending list and can complete payment later using manual payment API."
    },
    "BANK_TRANSFER": {
      "description": "Bank transfer payment method. Payment details stored for reference.",
      "requiredFields": {
        "bankName": "Name of the bank",
        "accountNumber": "Bank account number",
        "bankBranchName": "Branch name (optional but recommended)",
        "transactionNumber": "Unique transaction number (REQUIRED for validation)",
        "paymentDate": "Date of payment in YYYY-MM-DD format",
        "paymentAmount": "Amount transferred",
        "transactionReceiptUrl": "URL to receipt document (optional)"
      },
      "validation": "When completing payment via manual payment API, transactionNumber must match the stored value.",
      "nextSteps": "Client admin must use manual payment API with BANK_TRANSFER method and matching transactionNumber."
    },
    "CHECK_PAYMENT": {
      "description": "Check payment method. Check details stored for reference.",
      "requiredFields": {
        "checkNumber": "Check number (REQUIRED for validation)",
        "bankName": "Name of the bank",
        "branchName": "Branch name (optional but recommended)",
        "paymentDate": "Date of payment in YYYY-MM-DD format",
        "checkImageUrl": "URL to check image (optional)"
      },
      "validation": "When completing payment via manual payment API, checkNumber must match the stored value.",
      "nextSteps": "Client admin must use manual payment API with CHECK_PAYMENT method and matching checkNumber."
    }
  },
  "importantNotes": {
    "invoiceStatus": "IMPORTANT: Even when paymentStatus is COMPLETED, the invoice is ALWAYS created as PENDING. Payment details are stored for reference only.",
    "paymentCompletion": "To mark invoice as PAID, client admin must use the manual payment API (/billing/api/v1/payment/manual-entry) with matching payment details.",
    "validation": "Payment details (transactionNumber for bank transfer, checkNumber for check) are validated when completing payment via manual payment API.",
    "addressFields": "All address fields use new structured format. Old 'address' and 'billingAddress' fields are no longer accepted.",
    "billingAddress": "When useSameAsOrganizationAddress is true, billing address fields can be null. When false, streetAddress, city, zipPostalCode, and country are required."
  }
