					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"method\": \"EMAIL\",\n    \"tempToken\": \"{{tempToken}}\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/auth/api/v1/auth/mfa/generate-otp",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"auth",
								"api",
								"v1",
								"auth",
								"mfa",
								"generate-otp"
							]
						},
						"description": "Generate OTP code for EMAIL MFA method using tempToken. Email will be sent to user's registered email address."
					},
					"response": []
				}
			]
		},
