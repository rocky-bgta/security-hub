						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"method\": \"EMAIL\",\n    \"code\": \"{{otpCode}}\",\n    \"sessionId\": \"{{mfaSessionId}}\",\n    \"tempToken\": \"{{tempToken}}\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/auth/api/v1/auth/mfa/verify-otp",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"auth",
								"api",
								"v1",
								"auth",
								"mfa",
								"verify-otp"
							]
						},
						"description": "Verify OTP code received via Email using tempToken. Replace {{otpCode}} with actual OTP code. After successful verification, access token will be returned in tokenResponse."
					},
