									"        pm.environment.set(\"mfaSessionId\", jsonData.data.sessionId);",
									"        console.log(\"✓ OTP Session ID saved: \" + jsonData.data.sessionId);",
									"        console.log(\"✓ OTP expires in: \" + jsonData.data.expiresIn + \" seconds\");",
									"        console.log(\"⚠ Check your SMS for the OTP code\");",
									"    }",
									"} else {",
									"    console.log(\"✗ Failed to generate OTP: \" + pm.response.code);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"method\": \"SMS\",\n    \"phoneNumber\": \"{{phoneNumber}}\",\n    \"tempToken\": \"{{tempToken}}\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/auth/api/v1/auth/mfa/generate-otp",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"auth",
								"api",
								"v1",
								"auth",
								"mfa",
								"generate-otp"
							]
						},
						"description": "Generate OTP code for SMS MFA method using tempToken. Phone number is optional; when omitted, the phone number from the user profile is used. OTP will be sent via SMS."
					},
					"response": []
				},
