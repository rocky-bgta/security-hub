		{
			"name": "4. MFA - OTP Verification (Using TempToken)",
			"item": [
				{
					"name": "Verify OTP - SMS (with TempToken)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    var jsonData = pm.response.json();",
									"    if (jsonData.data) {",
									"        if (jsonData.data.verified) {",
									"            console.log(\"✓ OTP verified successfully!\");",
									"            ",
									"            // Save access token if returned (after successful MFA verification)",
									"            if (jsonData.data.tokenResponse && jsonData.data.tokenResponse.accessToken) {",
									"                pm.environment.set(\"accessToken\", jsonData.data.tokenResponse.accessToken);",
									"                pm.environment.set(\"refreshToken\", jsonData.data.tokenResponse.refreshToken);",
									"                console.log(\"✓ Access token saved - Login complete!\");",
									"                ",
									"                // Clear tempToken as it's no longer needed",
									"                pm.environment.set(\"tempToken\", \"\");",
									"            }",
									"        } else {",
									"            console.log(\"✗ OTP verification failed: \" + jsonData.data.message);",
									"        }",
									"    }",
									"} else {",
									"    console.log(\"✗ Verification failed: \" + pm.response.code);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"method\": \"SMS\",\n    \"code\": \"{{otpCode}}\",\n    \"sessionId\": \"{{mfaSessionId}}\",\n    \"tempToken\": \"{{tempToken}}\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/auth/api/v1/auth/mfa/verify-otp",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"auth",
								"api",
								"v1",
								"auth",
								"mfa",
								"verify-otp"
							]
						},
						"description": "Verify OTP code received via SMS using tempToken. Replace {{otpCode}} with actual OTP code. After successful verification, access token will be returned in tokenResponse."
					},
					"response": []
				},
				{
					"name": "Verify OTP - Email (with TempToken)",
					"event": [
						{
							"listen": "test",
