								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"method\": \"AUTHENTICATOR\",\n    \"code\": \"{{totpCode}}\",\n    \"sessionId\": \"00000000-0000-0000-0000-000000000000\",\n    \"tempToken\": \"{{tempToken}}\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/auth/api/v1/auth/mfa/verify-otp",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"auth",
								"api",
								"v1",
								"auth",
								"mfa",
								"verify-otp"
							]
						},
						"description": "Verify TOTP code from authenticator app using tempToken. Replace {{totpCode}} with actual TOTP code from your authenticator app. Note: sessionId is not used for AUTHENTICATOR method but is required in the request."
					},
					"response": []
				}
			]
		},
		{
			"name": "5. MFA - Authenticator Setup (Using TempToken)",
			"item": [
				{
					"name": "Setup Authenticator (Generate QR Code) - with TempToken",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    var jsonData = pm.response.json();",
									"    if (jsonData.data) {",
									"        pm.environment.set(\"totpSecret\", jsonData.data.secret);",
									"        pm.environment.set(\"otpauthUri\", jsonData.data.otpauthUri);",
									"        console.log(\"✓ TOTP Secret: \" + jsonData.data.secret);",
									"        console.log(\"✓ QR Code URL: \" + jsonData.data.qrCodeUrl);",
									"        console.log(\"✓ otpauth URI: \" + jsonData.data.otpauthUri);",
									"        console.log(\"\\n⚠ Scan the QR code or manually enter the secret in your authenticator app.\");",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"tempToken\": \"{{tempToken}}\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/auth/api/v1/auth/mfa/authenticator/setup",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"auth",
								"api",
								"v1",
								"auth",
								"mfa",
								"authenticator",
								"setup"
							]
						},
						"description": "Generate TOTP secret and QR code for authenticator app setup using tempToken. The secret is temporarily stored and will be saved after verification."
					},
					"response": []
				},
				{
					"name": "Verify Authenticator Setup - with TempToken",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    var jsonData = pm.response.json();",
									"    if (jsonData.data === true) {",
									"        console.log(\"✓ Authenticator setup completed successfully!\");",
									"        console.log(\"✓ MFA is now enabled for this user with AUTHENTICATOR method\");",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"code\": \"{{totpCode}}\",\n    \"tempToken\": \"{{tempToken}}\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/auth/api/v1/auth/mfa/authenticator/verify-setup",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"auth",
								"api",
								"v1",
								"auth",
								"mfa",
								"authenticator",
								"verify-setup"
							]
						},
						"description": "Verify TOTP code from authenticator app to complete setup using tempToken. Replace {{totpCode}} with actual TOTP code from your authenticator app. After successful verification, the TOTP secret will be saved and MFA will be enabled."
					},
					"response": []
				}
			]
		},
		{
			"name": "6. Complete Flow Examples",
			"item": [
				{
					"name": "Complete Flow - SMS MFA",
