	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [
					"// Auto-generate CurrentContext header from JWT token if available (for backward compatibility)",
					"const accessToken = pm.environment.get('accessToken');",
					"if (accessToken && !accessToken.includes('temp')) {",
					"    try {",
					"        // Decode JWT token (without verification)",
					"        const tokenParts = accessToken.split('.');",
					"        if (tokenParts.length === 3) {",
					"            const payload = JSON.parse(atob(tokenParts[1]));",
					"            const currentContext = {",
					"                userId: payload.sub || payload.userId || '',",
					"                username: payload.username || payload.preferred_username || '',",
					"                email: payload.email || '',",
					"                roles: payload.roles || []",
					"            };",
					"            // Base64 encode the context",
					"            const contextBase64 = btoa(JSON.stringify(currentContext));",
					"            pm.environment.set('currentContext', contextBase64);",
					"        }",
					"    } catch (e) {",
					"        console.log('Error generating CurrentContext:', e);",
					"    }",
					"}"
				]
			}
		}
