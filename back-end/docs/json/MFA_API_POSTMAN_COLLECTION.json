{
	"info": {
		"_postman_id": "mfa-api-collection-v2",
		"name": "ASAT MFA API Collection - Updated Flow",
		"description": "Complete collection for testing Multi-Factor Authentication (MFA) APIs with temporary token flow",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
		"version": "2.0.0"
	},
	"item": [
		{
			"name": "1. Login & Get TempToken",
			"item": [
				{
					"name": "Login (Get TempToken for MFA)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    var jsonData = pm.response.json();",
									"    if (jsonData.data) {",
									"        // Save access token if login is complete (no MFA required)",
									"        if (jsonData.data.accessToken) {",
									"            pm.environment.set(\"accessToken\", jsonData.data.accessToken);",
									"            pm.environment.set(\"refreshToken\", jsonData.data.refreshToken);",
									"            console.log(\"✓ Login successful - Access token saved\");",
									"        }",
									"        ",
									"        // Save tempToken if MFA is required",
									"        if (jsonData.data.tempToken) {",
									"            pm.environment.set(\"tempToken\", jsonData.data.tempToken);",
									"            console.log(\"✓ TempToken saved: \" + jsonData.data.tempToken.substring(0, 20) + \"...\");",
									"        }",
									"        ",
									"        // Log MFA status",
									"        if (jsonData.data.mfaSetupRequired) {",
									"            console.log(\"⚠ MFA Setup Required - User needs to set up MFA\");",
									"        }",
									"        if (jsonData.data.mfaVerificationRequired) {",
									"            console.log(\"⚠ MFA Verification Required - Method: \" + jsonData.data.mfaMethod);",
									"            pm.environment.set(\"mfaMethod\", jsonData.data.mfaMethod);",
									"        }",
									"    }",
									"} else {",
									"    console.log(\"✗ Login failed: \" + pm.response.code);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"username\": \"{{username}}\",\n    \"password\": \"{{password}}\",\n    \"deviceInfo\": {\n        \"platformType\": \"WEB\",\n        \"platformInfo\": \"GOOGLE CHROME\",\n        \"platformVersion\": \"1001.0.1.1\",\n        \"deviceIdentifier\": \"test-device-123\",\n        \"appLanguage\": \"ENGLISH\",\n        \"appVersion\": \"1.0.1\"\n    }\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/auth/api/v1/auth/login",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"auth",
								"api",
								"v1",
								"auth",
								"login"
							]
						},
						"description": "Login with username and password. If MFA is enabled and required, this will return a tempToken instead of accessToken. Use this tempToken for all subsequent MFA API calls."
					},
					"response": []
				}
			]
		},
		{
			"name": "2. Get MFA Methods",
			"item": [
				{
					"name": "Get Enabled MFA Methods",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    var jsonData = pm.response.json();",
									"    if (jsonData.data && jsonData.data.methods) {",
									"        console.log(\"✓ Available MFA Methods: \" + jsonData.data.methods.join(\", \"));",
									"        pm.environment.set(\"availableMfaMethods\", jsonData.data.methods.join(\",\"));",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/auth/api/v1/auth/mfa/methods",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"auth",
								"api",
								"v1",
								"auth",
								"mfa",
								"methods"
							]
						},
						"description": "Get list of MFA methods enabled globally for the system. No authentication required."
					},
					"response": []
				}
			]
		},
		{
			"name": "3. MFA - OTP Generation (Using TempToken)",
