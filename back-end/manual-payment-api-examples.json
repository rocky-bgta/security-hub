  "notes": {
    "required_fields": [
      "clientId",
      "invoiceId",
      "amount",
      "currency",
      "date",
      "packageItems",
      "paymentSources",
      "subtotal"
    ],
    "payment_methods": [
      "BANK_TRANSFER - Requires metadata with bank transfer details",
      "CHECK_PAYMENT - Requires metadata with check payment details",
      "CREDIT - Uses available credits, metadata can be null"
    ],
    "metadata_structure": {
      "BANK_TRANSFER": {
        "bankName": "string (required)",
        "accountNumber": "string (required)",
        "bankBranchName": "string (required)",
        "transactionNumber": "string (required)",
        "paymentDate": "YYYY-MM-DD (required)",
        "paymentAmount": "number (required)",
        "transactionReceiptUrl": "string (required)"
      },
      "CHECK_PAYMENT": {
        "checkNumber": "string (required)",
        "bankName": "string (required)",
        "branchName": "string (required)",
        "paymentDate": "YYYY-MM-DD (required)",
        "checkImageUrl": "string (required)"
      }
    },
    "important_points": [
      "The 'amount' field should equal the sum of all paymentSources amounts",
      "For BANK_TRANSFER and CHECK_PAYMENT, metadata is required and must match the invoice payment details",
      "The transactionNumber (for bank transfer) or checkNumber (for check payment) must match what was stored in the invoice during onboarding",
      "Date format: ISO 8601 format (e.g., '2025-12-07T10:30:00.000Z')",
      "Payment date in metadata should be in LocalDate format (YYYY-MM-DD)"
    ]
  }
}

